# ==============================================================================
# LIFE OS - ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para ".env" e preencha as variáveis correspondentes:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS: SUPABASE (PostgreSQL na Nuvem ou Local)
# ------------------------------------------------------------------------------
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection String
#
# DICA DE SEGURANÇA PARA SENHAS:
# Se a sua senha contiver caracteres especiais (ex: '@', ':', '/', '#'),
# utilize a codificação de URL (exemplo: '@' vira '%40').
# Não inclua os colchetes '[...]' na string final.

# Conexão principal da aplicação via Pooler (Porta 6543 - Transaction Mode com PgBouncer)
DATABASE_URL="postgresql://postgres.[SEU_PROJECT_REF]:[SUA_SENHA_URL_ENCODED]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta para Migrações do Prisma (Porta 5432 - Session Mode)
DIRECT_URL="postgresql://postgres.[SEU_PROJECT_REF]:[SUA_SENHA_URL_ENCODED]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE API & AUTH (Opcional se utilizar SDK do Supabase)
# ------------------------------------------------------------------------------
# Obtenha em: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[SEU_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. ALTERNATIVA: BANCO DE DADOS LOCAL (SQLite)
# ------------------------------------------------------------------------------
# Caso queira rodar 100% offline localmente sem Supabase:
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 4. AUTENTICAÇÃO & SERVIDOR
# ------------------------------------------------------------------------------
# Chave secreta para assinatura dos tokens JWT da sessão
AUTH_SECRET="sua-chave-secreta-longa-e-aleatoria-para-producao-2026"

# Porta de execução do servidor Next.js (Padrão: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 5. INTELIGÊNCIA ARTIFICIAL (Opcional - Sistema possui Fallback NLP local)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Obtenha em: https://aistudio.google.com/)
GEMINI_API_KEY="sua_chave_gemini_aqui"

# Groq Cloud API Key (Obtenha em: https://console.groq.com/keys)
GROQ_API_KEY="gsk_sua_chave_groq_aqui"
