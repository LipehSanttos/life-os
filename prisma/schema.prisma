datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String              @id @default(cuid())
  name               String              @default("Eduardo Felipe")
  email              String              @unique
  passwordHash       String
  avatarUrl          String?
  role               String              @default("USER") // ADMIN, USER
  tasks              Task[]
  projects           Project[]
  courses            Course[]
  books              Book[]
  financialReminders FinancialReminder[]
  chatSessions       ChatSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model UserSettings {
  id                    String   @id @default("user_default")
  name                  String   @default("Eduardo Felipe")
  email                 String   @default("eduardo.felipe@lifeos.com")
  theme                 String   @default("dark") // "dark" | "light" | "system"
  autoConfirmAiActions  Boolean  @default(false)
  notificationsEnabled  Boolean  @default(true)
  geminiApiKey          String?
  groqApiKey            String?
  aiProvider            String   @default("HYBRID") // "GEMINI" | "GROQ" | "HYBRID"
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Category {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  color              String              @default("#6366f1") // Hex color
  icon               String              @default("Folder") // Lucide icon name
  isSystem           Boolean             @default(false)
  sortOrder          Int                 @default(0)
  tasks              Task[]
  projects           Project[]
  courses            Course[]
  books              Book[]
  financialReminders FinancialReminder[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String?   @default("#3b82f6")
  icon        String?   @default("Briefcase")
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, ON_HOLD, ARCHIVED
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  startDate   DateTime?
  dueDate     DateTime?
  progress    Int       @default(0) // 0 - 100%
  notes       String?
  links       String?   // JSON array [{ title, url }]
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Course {
  id             String    @id @default(cuid())
  name           String
  institution    String?
  totalModules   Int       @default(1)
  currentModule  Int       @default(0)
  progress       Int       @default(0) // 0 - 100%
  status         String    @default("IN_PROGRESS") // NOT_STARTED, IN_PROGRESS, COMPLETED, ON_HOLD
  startDate      DateTime?
  dueDate        DateTime?
  notes          String?
  links          String?   // JSON array [{ title, url }]
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tasks          Task[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Book {
  id          String    @id @default(cuid())
  title       String
  author      String?
  isbn        String?
  coverUrl    String?
  totalPages  Int       @default(100)
  currentPage Int       @default(0)
  progress    Int       @default(0) // 0 - 100%
  status      String    @default("READING") // WANT_TO_READ, READING, COMPLETED, DROPPED
  startDate   DateTime?
  finishDate  DateTime?
  rating      Int?      // 1 - 5
  notes       String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FinancialReminder {
  id             String    @id @default(cuid())
  title          String
  description    String?
  amount         Float?    // Monetary value
  type           String    @default("EXPENSE") // EXPENSE, INCOME
  dueDate        DateTime
  status         String    @default("PENDING") // PENDING, PAID, OVERDUE
  isRecurring    Boolean   @default(false)
  recurrenceRule String?   // MONTHLY, WEEKLY, YEARLY, CUSTOM
  recurrenceDay  Int?      // e.g. Day 10 of month
  recipient      String?   // Recipient or Provider name
  proofUrl       String?
  notes          String?
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tasks          Task[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Task {
  id                  String             @id @default(cuid())
  title               String
  description         String?
  priority            String             @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status              String             @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, PAUSED, CANCELLED
  
  // User association
  userId              String?
  user                User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  categoryId          String?
  category            Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  projectId           String?
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  courseId            String?
  course              Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  bookId              String?
  book                Book?              @relation(fields: [bookId], references: [id], onDelete: SetNull)
  financialReminderId String?
  financialReminder   FinancialReminder? @relation(fields: [financialReminderId], references: [id], onDelete: SetNull)
  
  // Dates & Times
  startDate           DateTime?
  dueDate             DateTime?
  dueTime             String?            // "14:30"
  completedAt         DateTime?
  
  // Recurrence
  isRecurring         Boolean            @default(false)
  recurrenceRule      String?            // DAILY, WEEKLY, MONTHLY, ANNUAL, CUSTOM
  recurrenceInterval  Int?               @default(1)
  
  // Metadata
  tags                String?            // JSON array of strings
  notes               String?
  attachments         String?            // JSON array [{ title, url, type }]
  clientName          String?            // For freelance
  clientValue         Float?             // For freelance
  academicSubject     String?            // For college / faculdade
  isInbox             Boolean            @default(false) // True if created via quick inbox
  sortOrder           Int                @default(0)
  
  subtasks            Subtask[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Subtask {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String   // TASK, PROJECT, COURSE, BOOK, FINANCE
  entityId   String
  action     String   // CREATED, UPDATED, STATUS_CHANGED, COMPLETED, DELETED
  title      String
  details    String?  // JSON with changes/metadata
  createdAt  DateTime @default(now())
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String        @default("Nova Conversa")
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role          String      // "user" | "assistant" | "system" | "tool"
  content       String
  toolCalls     String?     // JSON array of tool calls
  toolResults   String?     // JSON array of tool results
  pendingAction String?     // JSON object of pending action needing user confirmation
  createdAt     DateTime    @default(now())
}
